{
  "schemaVersion": 1,
  "id": "chunkanimator",
  "version": "${version}",
  "name": "Chunk Animator",
  "description": "Animates chunks when they appear.",
  "authors": [
    "Donyka"
  ],
  "contact": {
    "sources": "https://github.com/sskyness/Chunk-Animator"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "ru.donyka.chunkanimator.ChunkAnimator"
    ],
    "modmenu": [
      "ru.donyka.chunkanimator.config.ChunkAnimatorModMenu"
    ]
  },
  "mixins": [
    "chunkanimator.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "cloth-config2": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=${java_version}"
  },
  "suggests": {
    "modmenu": "*"
  }
}
